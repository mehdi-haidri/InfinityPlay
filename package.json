{
  "name": "infinityplay",
  "version": "0.1.1",
  "description": "Desktop app for finding and streaming movies, TV shows, anime and live TV.",
  "main": "./out/main/index.js",
  "author": {
    "name": "EL HADRATI Othman",
    "email": "othmanelhadrati@gmail.com",
    "url": "https://github.com/ELhadratiOth"
  },
  "contributors": [
