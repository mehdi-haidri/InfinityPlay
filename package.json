{
  "name": "infinityplay",
  "version": "0.3.5",
  "description": "Desktop app for finding and streaming movies, TV shows, anime and live TV.",
  "desktopName": "InfinityPlay.desktop",
  "main": "./out/main/index.js",
  "author": {
    "name": "EL HADRATI Othman & Tajeddine Bourhim",
    "email": "othmanelhadrati@gmail.com",
    "url": "https://github.com/ELhadratiOth"
  },
  "contributors": [
    {
      "name": "Tajeddine Bourhim",
      "email": "bourhimtajeddine@gmail.com",
      "url": "https://github.com/Scorpiontaj"
    },
    {
      "name": "EL HADRATI Othman",
      "email": "othmanelhadrati@gmail.com",
      "url": "https://github.com/ELhadratiOth"
    }
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/ELhadratiOth/InfinityPlay.git"
  },
  "homepage": "https://github.com/ELhadratiOth/InfinityPlay",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "npx @biomejs/biome check src tests",
    "dist": "electron-vite build && electron-builder --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "release": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/release.ps1",
    "postinstall": "electron-builder install-app-deps",
    "cap:sync": "electron-vite build && cap sync android",
    "cap:open": "cap open android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/browser": "^8.0.4",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/outfit": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "@xhayper/discord-rpc": "^1.3.4",
    "bonjour-service": "^1.4.4",
    "builder-util-runtime": "^9.7.0",
    "castv2-client": "^1.2.0",
    "dashjs": "^5.2.1",
    "electron-updater": "^6.8.9",
    "js-md5": "^0.9.2",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@rse/ffmpeg": "^1.4.2",
    "@types/js-md5": "^0.8.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "hls.js": "^1.7.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "zustand": "^5.0.15"
  }
}
