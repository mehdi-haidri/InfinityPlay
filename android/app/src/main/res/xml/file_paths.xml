<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <external-path name="my_images" path="." />
    <cache-path name="my_cache_images" path="." />
    <external-cache-path name="external_cache" path="." />
    <!-- Saved videos live in the app's own external Movies folder; another player can only open
         one of them through a content URI, which needs the folder declared here. -->
    <external-files-path name="movies" path="Movies/" />
    <!-- Downloaded APK updates live in the app's external updates directory -->
    <external-files-path name="updates" path="updates/" />
    <external-files-path name="all_external_files" path="." />
    <files-path name="internal_files" path="." />
</paths>